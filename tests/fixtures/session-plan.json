  "plan": {
    "plan_schema": 1,
    "title": "Variance and rescaling",
    "target": "variance calculation, rescaling and covariance",
    "budget": 8,
    "probe": {
      "start": "scale",
      "questions": [
        {
          "id": "scale",
          "kind": "choice",
          "units": 1,
          "prompt": "A random variable X has variance 4. What is the variance of 3X + 5?",
          "options": [
            {
              "id": "a",
              "text": "12",
              "feedback": "That multiplies the variance by 3. Variance is built from squared distances, so a factor of 3 on X becomes a factor of 9 on the variance."
            },
            {
              "id": "b",
              "text": "36",
              "correct": true
            },
            {
              "id": "c",
              "text": "41",
              "feedback": "Adding 5 slides every value by the same amount, so the distances between values do not change. The shift adds nothing to the variance."
            },
            {
              "id": "d",
              "text": "17",
              "feedback": "That is 3 times 4 plus 5: it treats variance like the mean. The mean moves with the shift and scales by 3; the variance ignores the shift and scales by 9."
            }
          ],
          "on_correct": "twopoint",
          "on_wrong": "twopoint",
          "tests": "variance of a linear transformation: Var(aX + b) = a^2 Var(X)",
          "assumes": "variance is the average squared distance from the mean",
          "solution": "The shift of 5 moves every value equally, so spread is unchanged. The factor 3 stretches every distance by 3, and variance averages squared distances, so it grows by 3 squared, which is 9. Nine times 4 is 36."
        },
        {
          "id": "twopoint",
          "kind": "numeric",
          "units": 1,
          "prompt": "X equals 0 or 2, each with probability one half. What is Var(X)?",
          "answer": {
            "value": 1,
            "tolerance": 0.001
          },
          "feedback_wrong": "Find the mean first: it is 1. Each value is exactly 1 away from it, so the average squared distance is 1. A common slip is to use E[X^2], which is 2, without subtracting the square of the mean.",
          "on_correct": "why",
          "on_wrong": "why",
          "tests": "computing a variance from a distribution",
          "assumes": "expectation of a discrete variable",
          "solution": "E[X] = 0.5 * 0 + 0.5 * 2 = 1. Each value is 1 away from the mean, so E[(X - 1)^2] = 1. Equivalently E[X^2] - (E[X])^2 = 2 - 1 = 1."
        },
        {
          "id": "why",
          "kind": "short",
          "units": 1,
          "prompt": "In your own words: why can a variance never be negative?",
          "criteria": [
            "Says a variance is an average of squared distances from the mean",
            "Notes that a square is never negative, so an average of squares cannot be"
          ],
          "next": "end",
          "tests": "meaning of variance as a mean of squares",
          "solution": "Variance is E[(X - mean)^2], an average of squares. Every square is at least zero, so the average is at least zero; it is zero only if X never moves from its mean."
        }
      ]
    },
    "segments": [
      {
        "id": "spread",
        "role": "core",
        "title": "What variance measures",
        "covers": [
          "variance as average squared distance"
        ],
        "script": {
          "board_schema": 1,
          "steps": [
            {
              "id": "sp1",
              "say": "Variance measures how far a random variable typically sits from its mean.",
              "do": [
                {
                  "op": "write",
                  "text": "Variance",
                  "at": [
                    8,
                    6
                  ],
                  "size": "huge",
                  "color": "yellow",
                  "id": "sp-title"
                }
              ]
            },
            {
              "id": "sp2",
              "say": "Take each distance from the mean, square it, and average the squares.",
              "do": [
                {
                  "op": "math",
                  "tex": "\\mathrm{Var}(X) = E\\left[(X-\\mu)^2\\right]",
                  "at": [
                    8,
                    24
                  ],
                  "size": "large",
                  "id": "sp-def"
                }
              ]
            },
            {
              "id": "sp3",
              "say": "We square so that values above and below the mean cannot cancel each other.",
              "do": [
                {
                  "op": "highlight",
                  "target": "sp-def"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "scale-repair",
        "role": "repair",
        "title": "Scaling, slowly",
        "before": "scale",
        "plays_if": {
          "wrong": [
            "scale"
          ]
        },
        "covers": [
          "effect of shift and scale on variance"
        ],
        "script": {
          "board_schema": 1,
          "steps": [
            {
              "id": "rp1",
              "say": "Let us take scaling slowly with one concrete picture.",
              "do": [
                {
                  "op": "write",
                  "text": "Shift, then stretch",
                  "at": [
                    8,
                    6
                  ],
                  "size": "large",
                  "color": "green",
                  "id": "rp-title"
                }
              ]
            },
            {
              "id": "rp2",
              "say": "Sliding every value by five moves the whole cloud, but the gaps between values stay exactly as they were.",
              "do": [
                {
                  "op": "arrow",
                  "from": [
                    20,
                    50
                  ],
                  "to": [
                    60,
                    50
                  ],
                  "color": "blue",
                  "id": "rp-arrow"
                }
              ]
            },
            {
              "id": "rp3",
              "say": "Multiplying by three stretches every gap by three, and variance averages squared gaps, so it grows by nine.",
              "do": [
                {
                  "op": "math",
                  "tex": "3^2 \\cdot 4 = 36",
                  "at": [
                    8,
                    66
                  ],
                  "size": "large",
                  "id": "rp-calc"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "scale",
        "role": "core",
        "title": "Rescaling a variable",
        "covers": [
          "Var(aX+b) = a^2 Var(X)"
        ],
        "script": {
          "board_schema": 1,
          "steps": [
            {
              "id": "sc1",
              "say": "Now rescale: multiply X by a and add b.",
              "do": [
                {
                  "op": "math",
                  "tex": "Y = aX + b",
                  "at": [
                    8,
                    8
                  ],
                  "size": "large",
                  "id": "sc-y"
                }
              ]
            },
            {
              "id": "sc2",
              "say": "The variance of Y is a squared times the variance of X, and b does not appear.",
              "do": [
                {
                  "op": "math",
                  "tex": "\\mathrm{Var}(Y) = a^2\\,\\mathrm{Var}(X)",
                  "at": [
                    8,
                    26
                  ],
                  "size": "large",
                  "color": "yellow",
                  "id": "sc-var"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "moment-form",
        "role": "extension",
        "title": "A shortcut for computing it",
        "plays_if": {
          "correct": [
            "scale",
            "twopoint"
          ]
        },
        "covers": [
          "Var(X) = E[X^2] - (E[X])^2"
        ],
        "script": {
          "board_schema": 1,
          "steps": [
            {
              "id": "mf1",
              "say": "Since you have this, here is a shortcut for computing a variance.",
              "do": [
                {
                  "op": "math",
                  "tex": "\\mathrm{Var}(X) = E[X^2] - (E[X])^2",
                  "at": [
                    8,
                    8
                  ],
                  "size": "large",
                  "id": "mf-form"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "see-it",
        "role": "core",
        "title": "Seeing spread change",
        "covers": [
          "intuition for spread"
        ],
        "video": {
          "resource": "RES-example-variance-video",
          "start": 30,
          "end": 210,
          "notice": "Watch how the same shape gets wider while its centre stays put."
        }
      }
    ],
    "anticipated": [
      {
        "segment": "scale",
        "label": "Why does the constant not matter?",
        "match": [
          "why",
