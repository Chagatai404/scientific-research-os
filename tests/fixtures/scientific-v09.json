{
  "fixture_schema": 2,
  "scope": "Synthetic known examples and deliberately invalid claims; no project results, no learner evidence. 'outcome' is the verification outcome the engine must reach.",
  "cases": [
    {"id": "arithmetic-valid", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "sum", "kind": "evaluate", "expression": "2 + 2", "expected": 4}]},
    {"id": "arithmetic-invalid", "family": "general", "outcome": "invalidated",
     "checks": [{"id": "sum", "kind": "evaluate", "expression": "2 + 2", "expected": 5}]},
    {"id": "decimal-rounding-is-not-an-error", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "sum", "kind": "evaluate", "expression": "0.1 + 0.2", "expected": 0.3}]},
    {"id": "square-root-domain", "family": "general", "outcome": "invalidated",
     "description": "sqrt(x*x) = x for all real x fails at negative x.",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "sqrt(x*x)", "rhs": "x", "domain": {"x": {"min": -5, "max": 5}}}]},
    {"id": "square-root-domain-restricted", "family": "general", "outcome": "verified-in-scope",
     "description": "The same identity, honestly scoped to x >= 0.",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "sqrt(x*x)", "rhs": "x", "domain": {"x": {"min": 0, "max": 5}}}]},
    {"id": "cancelled-singularity-unscoped", "family": "general", "outcome": "invalidated",
     "description": "(x^2-1)/(x-1) = x+1 is undefined at x = 1 on one side only.",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "(x^2-1)/(x-1)", "rhs": "x+1", "domain": {"x": {"min": -5, "max": 5}}}]},
    {"id": "cancelled-singularity-scoped", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "(x^2-1)/(x-1)", "rhs": "x+1", "domain": {"x": {"min": -5, "max": 5, "exclude": [1]}}}]},
    {"id": "pythagorean-identity", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "sin(x)^2 + cos(x)^2", "rhs": "1", "domain": {"x": {"min": -10, "max": 10}}}]},
    {"id": "cancellation-artifact-identity", "family": "general", "outcome": "not-invalidated",
     "description": "(1-cos x)/x^2 = 2 sin^2(x/2)/x^2 is true; floating point alone fakes a mismatch near x = 0.",
     "checks": [{"id": "identity", "kind": "equivalent", "lhs": "(1-cos(x))/x^2", "rhs": "2*sin(x/2)^2/x^2",
                 "domain": {"x": {"min": -1, "max": 1, "exclude": [0]}}}]},
    {"id": "derivative-correct", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "d", "kind": "derivative", "function": "sin(x)^2", "expected": "sin(2*x)"}]},
    {"id": "derivative-wrong", "family": "general", "outcome": "invalidated",
     "checks": [{"id": "d", "kind": "derivative", "function": "sin(x)^2", "expected": "cos(x)^2"}]},
    {"id": "integral-correct", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "i", "kind": "integral", "integrand": "sin(x)", "lower": 0, "upper": "pi", "expected": 2}]},
    {"id": "integral-wrong", "family": "general", "outcome": "invalidated",
     "checks": [{"id": "i", "kind": "integral", "integrand": "sin(x)", "lower": 0, "upper": "pi", "expected": 3}]},
    {"id": "gaussian-integral", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "i", "kind": "integral", "integrand": "exp(-x*x)", "lower": "-inf", "upper": "inf", "expected": "sqrt(pi)"}]},
    {"id": "limit-correct", "family": "general", "outcome": "verified-in-scope",
     "checks": [{"id": "l", "kind": "limit", "expression": "sin(x)/x", "approaching": 0, "expected": 1}]},
    {"id": "limit-wrong", "family": "general", "outcome": "invalidated",
     "checks": [{"id": "l", "kind": "limit", "expression": "sin(x)/x", "approaching": 0, "expected": 2}]},
    {"id": "limit-cancellation-artifact", "family": "general", "outcome": "not-invalidated",
     "description": "(1-cos x)/x^2 -> 1/2 is true; naive floating point returns 0 at x = 1e-8. A correct claim must never be invalidated by that.",
     "checks": [{"id": "l", "kind": "limit", "expression": "(1-cos(x))/x^2", "approaching": 0, "expected": 0.5}]},
    {"id": "no-obligations", "family": "general", "outcome": "not-checked", "checks": []},

    {"id": "ecal-gamma-normalization", "family": "ams-ecal", "outcome": "verified-in-scope",
     "description": "Longitudinal gamma profile with shape a and scale b integrates to one.",
     "checks": [{"id": "norm", "kind": "integral", "integrand": "x^(a-1)*exp(-x/b)/(gamma(a)*b^a)", "lower": 0, "upper": "inf",
                 "params": {"a": 3, "b": 2}, "expected": 1}]},
    {"id": "ecal-gamma-missing-scale", "family": "ams-ecal", "outcome": "invalidated",
     "description": "Forgetting b^a leaves an integral of b^a = 8, not 1.",
     "checks": [{"id": "norm", "kind": "integral", "integrand": "x^(a-1)*exp(-x/b)/gamma(a)", "lower": 0, "upper": "inf",
                 "params": {"a": 3, "b": 2}, "expected": 1}]},
    {"id": "ecal-gamma-two-formulations", "family": "ams-ecal", "outcome": "verified-in-scope", "consequence": "consequential",
     "description": "Numerical quadrature of the unnormalized profile against the closed form gamma(a) b^a.",
     "checks": [{"id": "norm", "kind": "integral", "integrand": "x^(a-1)*exp(-x/b)", "lower": 0, "upper": "inf",
                 "params": {"a": 3, "b": 2}, "expected": 16, "analytic": "gamma(a)*b^a"}]},
    {"id": "ecal-gamma-single-method-consequential", "family": "ams-ecal", "outcome": "partially-verified", "consequence": "consequential",
     "description": "Same claim with only quadrature: a consequential claim lacks an independent reconstruction.",
     "checks": [{"id": "norm", "kind": "integral", "integrand": "x^(a-1)*exp(-x/b)", "lower": 0, "upper": "inf",
                 "params": {"a": 3, "b": 2}, "expected": 16}]},
    {"id": "ecal-depth-origin-undeclared", "family": "ams-ecal", "outcome": "unresolved",
     "description": "Fitted shape parameters survive a depth shift only if the origin convention is declared.",
     "checks": [{"id": "origin", "kind": "assumption-declared", "required": ["depth-origin-convention"]}]},
    {"id": "ecal-depth-origin-declared", "family": "ams-ecal", "outcome": "verified-in-scope",
     "assumptions": [{"id": "depth-origin-convention", "statement": "Depth is measured from the calorimeter entry face in X0 for source and target alike."}],
     "checks": [{"id": "origin", "kind": "assumption-declared", "required": ["depth-origin-convention"]}]},
    {"id": "ecal-correlated-parameters-treated-as-independent", "family": "ams-ecal", "outcome": "invalidated",
     "description": "Propagating correlated a and b as if independent (sigma 0.848528 instead of 1.169616).",
     "checks": [{"id": "sigma", "kind": "propagation", "function": "a*b",
                 "variables": {"a": {"value": 3, "sigma": 0.3}, "b": {"value": 2, "sigma": 0.2}},
                 "correlations": {"a,b": 0.9}, "claimed_sigma": 0.848528}]},
    {"id": "ecal-correlated-parameters-propagated", "family": "ams-ecal", "outcome": "verified-in-scope", "consequence": "consequential",
     "checks": [{"id": "sigma", "kind": "propagation", "function": "a*b",
                 "variables": {"a": {"value": 3, "sigma": 0.3}, "b": {"value": 2, "sigma": 0.2}},
                 "correlations": {"a,b": 0.9}, "claimed_sigma": 1.169616, "tolerance": {"rel": 1e-5}}]},
    {"id": "ecal-energy-plus-length", "family": "ams-ecal", "outcome": "invalidated",
     "checks": [{"id": "dims", "kind": "dimensional", "expression": "E + L", "units": {"E": "GeV", "L": "cm"}}]},
    {"id": "ecal-depth-in-X0-plus-cm", "family": "ams-ecal", "outcome": "invalidated",
     "description": "Radiation lengths are material-dependent; they never convert to cm silently.",
     "checks": [{"id": "dims", "kind": "dimensional", "expression": "t + z", "units": {"t": "X0", "z": "cm"}}]},
    {"id": "ecal-dimensionally-consistent-energy", "family": "ams-ecal", "outcome": "verified-in-scope",
     "checks": [{"id": "dims", "kind": "dimensional", "expression": "m*v^2/2", "units": {"m": "kg", "v": "m/s"}, "expected_unit": "J"}]},
    {"id": "ecal-simulation-output-as-measurement", "family": "ams-ecal", "outcome": "unresolved",
     "description": "Deposited energy is not a calibrated signal without a response model.",
     "checks": [{"id": "map", "kind": "mapping-declared", "observable_a": "simulated deposited energy", "observable_b": "calibrated measured signal"}]},
    {"id": "ecal-observable-comparison-without-mapping", "family": "ams-ecal", "outcome": "unresolved",
     "checks": [{"id": "map", "kind": "mapping-declared", "observable_a": "total shower energy", "observable_b": "single-layer signal"}]},
    {"id": "ecal-observable-comparison-with-mapping", "family": "ams-ecal", "outcome": "verified-in-scope",
     "checks": [{"id": "map", "kind": "mapping-declared", "observable_a": "total shower energy", "observable_b": "single-layer signal",
                 "mapping": "Single-layer signal = layer sampling fraction x deposited energy, from the declared response simulation."}]},
    {"id": "ecal-zero-false-positives-infinite-rejection", "family": "ams-ecal", "outcome": "invalidated",
     "checks": [{"id": "rate", "kind": "rate-interval", "successes": 0, "trials": 1000, "claimed": {"rejection": {"value": "inf"}}}]},
    {"id": "ecal-rejection-factor-overclaimed", "family": "ams-ecal", "outcome": "invalidated",
     "description": "With 0 of 500, the rejection factor is bounded below near 136, not 10000.",
     "checks": [{"id": "rate", "kind": "rate-interval", "successes": 0, "trials": 500, "claimed": {"rejection": {"value": 10000, "lower": 10000}}}]},
    {"id": "ecal-zero-count-with-zero-uncertainty", "family": "ams-ecal", "outcome": "invalidated",
     "checks": [{"id": "rate", "kind": "rate-interval", "successes": 0, "trials": 500, "claimed": {"sigma": 0}}]},
    {"id": "ecal-zero-count-honest-interval", "family": "ams-ecal", "outcome": "verified-in-scope", "consequence": "consequential",
     "requires_libraries": ["scipy"], "outcome_without_libraries": "partially-verified",
     "checks": [{"id": "rate", "kind": "rate-interval", "successes": 0, "trials": 500, "claimed": {"interval": [0, 0.0075]}}]},
    {"id": "ecal-iid-bootstrap-of-correlated-layers", "family": "ams-ecal", "outcome": "invalidated",
     "checks": [{"id": "unit", "kind": "resampling-unit", "resampled_unit": "layer", "independent_unit": "event", "dependence": "correlated"}]},
    {"id": "ecal-bootstrap-by-event", "family": "ams-ecal", "outcome": "verified-in-scope",
     "checks": [{"id": "unit", "kind": "resampling-unit", "resampled_unit": "event", "independent_unit": "event"}]},
    {"id": "ecal-bootstrap-dependence-undeclared", "family": "ams-ecal", "outcome": "unresolved",
     "checks": [{"id": "unit", "kind": "resampling-unit", "resampled_unit": "layer", "independent_unit": "event"}]},
    {"id": "ecal-scaler-fit-on-train-and-test", "family": "ams-ecal", "outcome": "invalidated",
     "checks": [{"id": "leak", "kind": "fit-partition", "evaluated_on": "test",
                 "steps": [{"name": "scaler", "fit_on": ["train", "test"]}, {"name": "classifier", "fit_on": ["train"]}]}]},
    {"id": "ecal-no-leakage", "family": "ams-ecal", "outcome": "verified-in-scope",
     "checks": [{"id": "leak", "kind": "fit-partition", "evaluated_on": "test",
                 "steps": [{"name": "scaler", "fit_on": ["train"]}, {"name": "classifier", "fit_on": ["train"]}]}]},
    {"id": "ecal-detector-regime-mismatch", "family": "ams-ecal", "outcome": "unresolved",
     "description": "Calibration measured at 10-100 GeV is applied at 1 GeV-1 TeV.",
     "checks": [{"id": "regime", "kind": "regime-match", "source": {"energy_GeV": [10, 100]}, "target": {"energy_GeV": [1, 1000]}}]},
    {"id": "ecal-detector-regime-covered", "family": "ams-ecal", "outcome": "verified-in-scope",
     "checks": [{"id": "regime", "kind": "regime-match", "source": {"energy_GeV": [1, 1000]}, "target": {"energy_GeV": [10, 100]}}]}
  ]
}
