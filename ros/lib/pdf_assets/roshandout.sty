% roshandout.sty: the study-handout style of Scientific Research OS (v0.9.7).
% Compile with xelatex (latexmk -xelatex). Only packages that ship with a basic MiKTeX install are used:
%   amsmath amssymb amsthm mathtools fontspec unicode-math geometry xcolor microtype hyperref fancyhdr titlesec
%   booktabs enumitem tcolorbox (+ its skins, breakable, theorems libraries) longtable array graphicx caption
%   tikz pgfplots etoolbox
% `python -m ros.lib.pdf template` prints the environments and macros a handout body may use.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{roshandout}[2026/10/18 Research OS study handout]

% ---------- fonts: Latin Modern (covers the Turkish letters) ----------
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
% Fonts are loaded by file name from the TeX tree (not by family name) so XeTeX never scans the system font list: faster and the same on every machine.
\setmainfont{lmroman10-regular.otf}[BoldFont=lmroman10-bold.otf,ItalicFont=lmroman10-italic.otf,BoldItalicFont=lmroman10-bolditalic.otf]
\setsansfont{lmsans10-regular.otf}[BoldFont=lmsans10-bold.otf,ItalicFont=lmsans10-oblique.otf]
\setmonofont{lmmono10-regular.otf}[ItalicFont=lmmono10-italic.otf]
\setmathfont{latinmodern-math.otf}
\RequirePackage{microtype}

% ---------- page: wide outer margin for the learner's own notes ----------
\RequirePackage[a4paper,left=22mm,right=48mm,top=22mm,bottom=22mm,marginparwidth=38mm,marginparsep=6mm,headheight=14pt,footskip=12mm]{geometry}
\RequirePackage{xcolor}
\definecolor{roshblue}{HTML}{1B5E9B}
\definecolor{roshgreen}{HTML}{2E7D32}
\definecolor{roshred}{HTML}{B3261E}
\definecolor{roshgrey}{HTML}{555555}
\definecolor{roshblueback}{HTML}{EEF4FA}
\definecolor{roshgreenback}{HTML}{EFF7EF}
\definecolor{roshamberback}{HTML}{FFF6E5}
\definecolor{roshamber}{HTML}{B26A00}
\definecolor{roshredback}{HTML}{FCEFEE}
\definecolor{roshgreyback}{HTML}{F4F4F4}

\RequirePackage{booktabs,array,longtable,graphicx,caption}
\RequirePackage[shortlabels]{enumitem}
\setlist{itemsep=2pt,topsep=4pt,parsep=0pt}
\captionsetup{font=small,labelfont={bf,color=roshblue},labelsep=period}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt minus 1pt}
\linespread{1.04}
\emergencystretch=2em

% ---------- hyperref (internal and external links, never a launch action) ----------
\RequirePackage[hidelinks,unicode,pdfusetitle,bookmarksnumbered=true]{hyperref}
\hypersetup{colorlinks=true,linkcolor=roshblue,citecolor=roshblue,urlcolor=roshblue}

% ---------- sections: green, ruled, numbered ----------
\RequirePackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{roshgreen}}{\thesection.}{0.5em}{}[{\color{roshgreen}\titlerule[0.7pt]}]
\titleformat{\subsection}{\large\bfseries\color{roshblue}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape\color{roshgrey}}{}{0em}{}
\titlespacing*{\section}{0pt}{16pt plus 4pt minus 2pt}{8pt}
\titlespacing*{\subsection}{0pt}{11pt plus 3pt minus 2pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{7pt plus 2pt minus 1pt}{2pt}

% ---------- header and footer ----------
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\newcommand{\roshmetatitle}{}
\newcommand{\roshmetasubtitle}{}
\newcommand{\roshmetacourse}{}
\newcommand{\roshmetadate}{}
\newcommand{\roshmetaline}{}
\newcommand{\handoutmeta}[5]{%
  \renewcommand{\roshmetatitle}{#1}\renewcommand{\roshmetasubtitle}{#2}\renewcommand{\roshmetacourse}{#3}%
  \renewcommand{\roshmetadate}{#4}\renewcommand{\roshmetaline}{#5}}
\AtEndDocument{\label{rosh@lastpage}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{roshblue}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\bfseries\roshmetacourse}
\fancyhead[R]{\small\color{roshgrey}\roshmetatitle}
\fancyfoot[L]{\footnotesize\color{roshgrey}Study handout}
\fancyfoot[R]{\footnotesize\color{roshgrey}Page \thepage\ of \pageref*{rosh@lastpage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\footnotesize\color{roshgrey}Study handout}\fancyfoot[R]{\footnotesize\color{roshgrey}Page \thepage\ of \pageref*{rosh@lastpage}}}

% ---------- title block ----------
\newcommand{\makehandouttitle}{%
  \thispagestyle{plain}%
  {\small\color{roshgrey}\textbf{\roshmetacourse}\hfill\roshmetadate\par
   \roshmetaline\par}%
  \vspace{6pt}%
  \begin{center}
    {\color{roshblue}\LARGE\bfseries\roshmetatitle\par}
    \ifdefempty{\roshmetasubtitle}{}{\vspace{3pt}{\large\bfseries\roshmetasubtitle\par}}
  \end{center}
  \vspace{-4pt}{\color{roshblue}\hrule height 0.8pt}\vspace{8pt}}

% ---------- boxes ----------
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\tcbset{roshbase/.style={enhanced,breakable,boxrule=0.6pt,arc=2pt,left=7pt,right=7pt,top=5pt,bottom=5pt,
  before skip=9pt,after skip=9pt,fonttitle=\bfseries\small,attach boxed title to top left={yshift=-2.1mm,xshift=6pt},
  boxed title style={boxrule=0pt,arc=1.5pt,top=1pt,bottom=1pt,left=4pt,right=4pt},
  title={}}}

\newtcolorbox[auto counter,number within=section]{definition}[1][]{roshbase,
  colback=roshblueback,colframe=roshblue,coltitle=white,colbacktitle=roshblue,
  title={Definition \thetcbcounter\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newtcolorbox[use counter from=definition]{rulebox}[1][]{roshbase,
  colback=roshgreenback,colframe=roshgreen,coltitle=white,colbacktitle=roshgreen,
  title={Rule \thetcbcounter\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newtcolorbox{keyidea}[1][]{roshbase,colback=roshamberback,colframe=roshamber,coltitle=white,colbacktitle=roshamber,
  title={Key idea\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newtcolorbox{commonmistake}[1][]{roshbase,colback=roshredback,colframe=roshred,coltitle=white,colbacktitle=roshred,
  title={Common slip\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newtcolorbox{remark}[1][]{roshbase,colback=roshgreyback,colframe=roshgrey,coltitle=white,colbacktitle=roshgrey,
  title={Note\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newtcolorbox{gaps}[1][]{roshbase,colback=roshgreyback,colframe=roshgrey,coltitle=white,colbacktitle=roshgrey,
  title={What the probe showed\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}

% A worked example: statement first, then \solution; numbered through the document.
\newtcolorbox[auto counter]{workedexample}[1][]{roshbase,
  colback=white,colframe=roshblue!70,colbacktitle=roshblue!70,coltitle=white,
  title={Example \thetcbcounter\ifstrempty{#1}{}{ \textnormal{\textemdash}\ #1}}}
\newcommand{\solution}{\par\smallskip\noindent\textbf{\color{roshblue}Solution.}\ }
\newcommand{\sourcenote}[1]{\par\smallskip{\footnotesize\color{roshgrey}Source: #1}}

% A short note in the wide outer margin.
\newcommand{\margin}[1]{\marginpar{\raggedright\footnotesize\color{roshgrey}#1}}

% ---------- theorem-like text (unboxed, for proofs) ----------
\theoremstyle{plain}
\newtheorem{proposition}{Proposition}[section]
\renewcommand{\qedsymbol}{$\blacksquare$}

% ---------- exercises: set in the text, solutions collected and printed once ----------
\newcounter{roshexercise}
\newcommand{\roshsolutions}{}
\newcommand{\exercise}[3][]{%
  \refstepcounter{roshexercise}%
  \par\medskip\noindent{\bfseries\color{roshblue}Exercise \theroshexercise\ifstrempty{#1}{}{ (#1)}.}\ #2\par
  \xappto\roshsolutions{\unexpanded{\par\medskip\noindent{\bfseries\color{roshgreen}Exercise}\space}\arabic{roshexercise}\unexpanded{.}\space}%
  \gappto\roshsolutions{#3\par}}
\newcommand{\printsolutions}{%
  \begingroup\roshsolutions\endgroup}
\newenvironment{parts}{\begin{enumerate}[label=(\alph*),leftmargin=2em,itemsep=2pt]}{\end{enumerate}}

% ---------- notation table ----------
\newenvironment{notationtable}{%
  \par\smallskip\noindent
  \begin{longtable}{@{}>{\raggedright\arraybackslash}p{0.27\textwidth}>{\raggedright\arraybackslash}p{0.66\textwidth}@{}}
  \toprule\textbf{Symbol} & \textbf{Meaning}\\\midrule\endfirsthead
  \toprule\textbf{Symbol} & \textbf{Meaning}\\\midrule\endhead
  \bottomrule\endlastfoot}{\end{longtable}}

% ---------- sources: ordinary \bibitem entries, cited with \cite{key} ----------
\newenvironment{sources}{%
  \renewcommand{\refname}{Sources}%
  \begin{thebibliography}{99}\setlength{\itemsep}{2pt}\small}{\end{thebibliography}}

% ---------- figures and plots ----------
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18,width=0.85\linewidth,height=5.5cm,every axis/.append style={font=\small,tick label style={font=\footnotesize}}}
\usetikzlibrary{arrows.meta,calc,positioning}

% ---------- mathematics shortcuts ----------
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\SD}{SD}
\newcommand{\E}{\operatorname{E}}
\renewcommand{\Pr}{\operatorname{P}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\dd}{\,\mathrm{d}}
\newcommand{\ind}{\mathbf{1}}
\newcommand{\iid}{\text{i.i.d.}}
\newcommand{\given}{\mid}
\newcommand{\eqdef}{\mathrel{\mathop:}=}
